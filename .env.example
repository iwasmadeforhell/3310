# --- Secrets (set these in Vercel → Project → Settings → Environment Variables) ---

# Random string, 32+ characters. Signs all login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Password for viewing portfolio.3310.nz
PORTFOLIO_PASSWORD=

# Password for drop.3310.nz (URL shortener + file hosting)
DROP_PASSWORD=

# Admin password: posting on old.3310.nz and managing the portfolio
ADMIN_PASSWORD=

# Changing a password signs out everyone who logged in with the old one.

# --- Added automatically by Vercel integrations ---
# Upstash Redis (Vercel Marketplace → Upstash → Redis), either naming works:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (Storage → Create → Blob → access: PRIVATE)
# BLOB_READ_WRITE_TOKEN=

# Optional: your root domain (defaults to 3310.nz)
# ROOT_DOMAIN=3310.nz
