# --- Secrets (set these in Vercel → Project → Settings → Environment Variables) ---

# Random string, 32+ characters. Signs all login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Password for viewing portfolio.3310.nz
PORTFOLIO_PASSWORD=

# Password for uploading and managing work at portfolio.3310.nz/manage
PORTFOLIO_MANAGE_PASSWORD=

# Password for drop.3310.nz (URL shortener + file hosting)
DROP_PASSWORD=

# Owner password for forum.3310.nz (the owner logs in on the same form as forum members)
ADMIN_PASSWORD=

# Optional: admin username asked for alongside ADMIN_PASSWORD (defaults to "nokia")
# ADMIN_USERNAME=nokia

# Random string. Vercel sends it with the daily cron that deletes expired drop files.
CRON_SECRET=

# Changing a password signs out everyone who logged in with the old one.

# --- Added automatically by Vercel integrations ---
# Upstash Redis (Vercel Marketplace → Upstash → Redis), either naming works:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (Storage → Create → Blob → access: PRIVATE)
# BLOB_READ_WRITE_TOKEN=

# Optional: size of the Blob store in GB, for the storage bar on drop (defaults to 1)
# BLOB_QUOTA_GB=1

# Optional: your root domain (defaults to 3310.nz)
# ROOT_DOMAIN=3310.nz
